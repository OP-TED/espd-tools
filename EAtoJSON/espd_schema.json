{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OP-TED/ESPD-EDM/blob/espd-tools/EAtoJSON/espd_schema.json",
  "title": "ESPD_EDM",
  "description": "ESPD EDM JSON validation schema",
  "$defs": {
    "cardinalityType": {
      "enum" : ["1", "0..n", "1..n", "0..1"]
    },
    "componentType" :{
      "enum": ["QUESTION_GROUP", "QUESTION_SUBGROUP", "REQUIREMENT_GROUP", "REQUIREMENT_SUBGROUP", "QUESTION", "REQUIREMENT", "CAPTION", "SUBCRITERION", "ADDITIONAL_DESCRIPTION_LINE", "LEGISLATION", "CRITERION"]
    },
    "legislation" : {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "type": { "enum": ["LEGISLATION"] },
        "cardinality": { "$ref" : "#/$defs/cardinalityType" },
        "requestpath": { "type":"string" },
        "responsepath": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": [ "tag", "type", "cardinality", "requestpath", "responsepath", "title" ]
    },
    "componentItem": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "type": { "$ref": "#/$defs/componentType" },
        "cardinality": { "$ref" : "#/$defs/cardinalityType" },
        "code": { "type": "string"},
        "codelist": { "type": "string" },
        "requestpath": { "type":"string" },
        "responsepath": { "type": "string" },
        "contentpath": { "type": "string" },
        "components": { 
          "type": "array",
          "items": { "$ref": "#/$defs/componentItem" }
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "propertydatatype": { "type": "string" },
        "sellervalue": { "type": "string" },
        "buyervalue": { "type": "string" }
      },
      "required": [ "tag", "type", "cardinality", "requestpath", "responsepath" ]
    },
    "criterion": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "type": { "enum": ["CRITERION"] },
        "uuid": { "type": "string" },
        "code": { "type": "string" },
        "cardinality": { "$ref" : "#/$defs/cardinalityType" },
        "components": { 
          "type": "array",  
          "items": { "$ref": "#/$defs/componentItem" }
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "requestpath": { "type": "string" },
        "responsepath": { "type": "string" }
      },
      "required": [ "tag", "type", "uuid", "code", "cardinality", "components", "name", "requestpath", "responsepath" ]
    },
    "additionalInformation": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "type": { "enum": ["ADDITIONAL_INFORMATION"] },
        "code": { "type": "string" },
        "cardinality": { "$ref" : "#/$defs/cardinalityType" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentItem" }
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "requestpath": { "type": "string" },
        "responsepath": { "type": "string" }
      },
      "required": [ "tag", "type", "cardinality", "components", "name", "requestpath", "responsepath" ]
    }
  },
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/criterion" },
      { "$ref": "#/$defs/additionalInformation" }
    ]
  }
}
